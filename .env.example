# Password for the web UI at https://browser.krish.in.net  (required)
UI_PASSWORD=change-me-to-a-long-password

# Secret token that agents must send to use the MCP endpoint (required)
# Generate one with:  openssl rand -hex 32
MCP_TOKEN=change-me-to-a-long-random-token

# Public address of the app (used only to show the correct MCP URL in the UI)
PUBLIC_URL=https://browser.krish.in.net

# Optional: starting screen size of the browser (it resizes to fit your window anyway)
SCREEN_SIZE=1440x900
