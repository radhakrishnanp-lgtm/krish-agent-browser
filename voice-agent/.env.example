# Copy to .env and fill in. Never commit .env.
ISOQUANT_API_KEY=
OPENROUTER_API_KEY=

# Optional: require this token to open the UI / WebSocket (recommended when deployed publicly).
ACCESS_TOKEN=

# Optional overrides
# VOICE_AGENT_PRESET=default
# PORT=8080

# Optional: host names the UI is served from, comma separated (e.g. voice.example.com).
# Only needed if a proxy changes the Host header and the page cannot connect.
# ALLOWED_ORIGINS=
